{
  "id": "boss-rc500",
  "name": "BOSS RC-500",
  "version": "1.0.0",
  "protocol": 3,
  "workFile": "work.js",
  "permissions": [
    "midi-out:rc-500"
  ],
  "provides": [
    "rc500-control"
  ],
  "midiDevice": true,
  "contributes": {
    "methods": {
      "event": {
        "in": {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "maxLength": 100
            },
            "payload": {
              "type": "object"
            },
            "midiChannel": {
              "type": "integer"
            }
          }
        },
        "out": {
          "type": "object",
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "type": "string"
            }
          }
        },
        "timeoutMs": 5000
      }
    }
  }
}
