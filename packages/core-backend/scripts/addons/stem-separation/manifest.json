{
  "id": "stem-separation",
  "name": "Stem-Trennung (Demucs)",
  "version": "1.0.0",
  "protocol": 3,
  "workFile": "work.js",
  "permissions": [
    "helper:stems"
  ],
  "contributes": {
    "methods": {
      "separate": {
        "in": {
          "type": "object",
          "required": [
            "audio",
            "model"
          ],
          "properties": {
            "model": {
              "enum": [
                "standard",
                "extended"
              ]
            },
            "splitGuitar": {
              "type": "boolean"
            }
          }
        },
        "out": {
          "type": "object",
          "required": [
            "stems"
          ],
          "properties": {}
        },
        "timeoutMs": 1500000,
        "progress": true
      }
    }
  }
}
