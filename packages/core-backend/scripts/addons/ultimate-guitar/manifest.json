{
  "id": "ultimate-guitar-scraper",
  "name": "Ultimate Guitar Import",
  "version": "1.0.0",
  "protocol": 3,
  "pluginId": "ultimate-guitar-import",
  "provides": [
    "chord-import"
  ],
  "legalRisk": true,
  "lookup": {
    "requiresInstall": true
  },
  "workFile": "work.js",
  "permissions": [
    "helper:ug-page"
  ],
  "contributes": {
    "methods": {
      "search": {
        "in": {
          "type": "object",
          "required": [
            "query"
          ],
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          }
        },
        "out": {
          "type": "array"
        },
        "timeoutMs": 90000,
        "callableByDevices": true
      },
      "fetchDetail": {
        "in": {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 600
            }
          }
        },
        "out": {
          "type": "object"
        },
        "timeoutMs": 90000,
        "callableByDevices": true
      }
    }
  }
}
