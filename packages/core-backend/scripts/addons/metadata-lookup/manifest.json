{
  "id": "metadata-lookup",
  "name": "Musik-Metadaten (MusicBrainz)",
  "version": "1.0.0",
  "protocol": 3,
  "lookup": {
    "requiresInstall": false
  },
  "workFile": "work.js",
  "permissions": [
    "http:https://musicbrainz.org"
  ],
  "contributes": {
    "methods": {
      "search": {
        "in": {
          "type": "object",
          "required": [
            "query"
          ],
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          }
        },
        "out": {
          "type": "array"
        },
        "timeoutMs": 30000,
        "callableByDevices": true
      },
      "fetchDetail": {
        "in": {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        },
        "out": {
          "type": "object"
        },
        "timeoutMs": 30000,
        "callableByDevices": true
      }
    }
  }
}
