# For tablets on the stage LAN, use the server's LAN address here instead of localhost
# (a tablet asking for localhost:5984 would ask itself), and add the matching origin
# to CouchDB's CORS list: FRONTEND_ORIGIN="https://localhost:5173,https://<ip>:5173" scripts/setup-couchdb.sh
#
# https:// + port 6984, not http://+5984, once `scripts/generate-dev-certs.sh` has been run
# (see #34): getUserMedia()/WebMIDI need a secure context, and once stage-pwa itself serves
# over HTTPS (same script's cert, picked up by vite.config.ts), a plain-HTTP CouchDB fetch
# is mixed content and gets blocked by the browser. Falls back to http://+5984 automatically
# on both the Vite and Fastify side if the certs haven't been generated - only CouchDB
# doesn't self-detect that, so http:// URLs here still work as long as CouchDB's own
# `docker/couchdb-ssl.ini` mount hasn't been added either.
VITE_COUCHDB_URL=https://localhost:6984/stageboard-band-a
VITE_COUCHDB_USER=admin
VITE_COUCHDB_PASSWORD=admin
# The Stage-Server's Fastify port (default 3001, same port whether http or https - Fastify
# picks the protocol from whether it found the shared certs, not from this URL's scheme).
# Same LAN-address rule as VITE_COUCHDB_URL, and the server needs the matching
# FRONTEND_ORIGIN env var set for CORS.
VITE_STAGE_SERVER_URL=https://localhost:3001
